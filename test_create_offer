CLIENT_SECRET = "070a2839-315f-48cb-9834-b818948979e2$gDS3MxTiFCAeToiE9e5k2tQpmL6dD5SdYIS-rkQRhi4="


def getAccessToken():
    """
    Generates an SAP OAuth2 access token using client_credentials.
    """
    raw = f"{CLIENT_ID}:{CLIENT_SECRET}"
    basic = base64.b64encode(raw.encode()).decode()

    headers = {
        "Content-Type": "application/x-www-form-urlencoded",
        "Authorization": f"Basic {basic}"
    }

    resp = requests.post(SAP_TOKEN_URL, headers=headers, data={"grant_type": "client_credentials"})

    if resp.status_code != 200:
        print("❌ Error fetching token:", resp.text)
        resp.raise_for_status()

    print("✅ Token obtained successfully")
    return resp.json()["access_token"]


def create_offer(group, product_id, start_date):
    """
    Calls the Offer Creation API (Schnittstelle 3)
    """
    token = getAccessToken()

    headers = {
        "Authorization": f"Bearer {token}",
        "Gruppe": group,
        "Produkt": product_id,
        "Content-Type": "application/json",
    }

    body = {"STARTDATE": start_date}

    resp = requests.post(OFFER_URL, headers=headers, json=body)

    if resp.status_code == (200, 201):
        print("✅ Offer created successfully")
    else:
        print("❌ Offer creation failed:", resp.status_code, resp.text)
        resp.raise_for_status()

    return resp.json()


